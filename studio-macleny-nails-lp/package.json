{
  "name": "studio-macleny-nails-lp",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page oficial do Studio Macleny Nails.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:config": "node scripts/validate-config.mjs",
    "check:config:strict": "node scripts/validate-config.mjs --strict",
    "verify": "npm run lint && npm run typecheck && npm run check:config && npm run build"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

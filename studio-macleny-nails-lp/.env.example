# ---------------------------------------------------------------------------
# Studio Macleny Nails — variaveis de ambiente
# Copie este arquivo para .env.local e preencha APENAS com valores reais.
# NUNCA faca commit de .env.local nem de qualquer segredo.
# ---------------------------------------------------------------------------

# Dominio canonico COM protocolo, sem barra final. Ex.: https://www.exemplo.com.br
# Enquanto nao estiver confirmado, deixe vazio: o projeto usa fallback local.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager. Formato GTM-XXXXXXX. Deixe vazio para desativar.
NEXT_PUBLIC_GTM_ID=

# Google Ads. Formato AW-000000000. Deixe vazio para desativar.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Label da acao de conversao "Contato WhatsApp". Ex.: AbC-D_efG12hIjKlM
# Usado APENAS na rota Google Tag direto (sem GTM).
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
